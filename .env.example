# Database (on Vercel, Neon adds these for you)
DATABASE_URL="postgresql://crest:crest@localhost:5432/crest?schema=public"
# Direct (unpooled) connection used for migrations, if your provider gives one:
# DATABASE_URL_UNPOOLED=   or   DIRECT_URL=

# First administrator — created automatically while no administrator exists
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-first-sign-in

# Vercel Cron sends this as a Bearer token to /api/cron/generate-sessions
CRON_SECRET=change-me-to-a-long-random-string

# Local preview only — render as a seeded user without signing in (ignored in production)
# DEV_AUTH_USER_ID=seed_admin

# Later modules
# CLOUDINARY_URL=cloudinary://key:secret@cloud      (Module 4 – resources)
# Optional embedded classroom for enrollments without a Google Meet link:
# JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxx
# JAAS_API_KEY_ID=vpaas-magic-cookie-xxxxxxxx/abc123
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# …or a self-hosted Jitsi server instead:
# JITSI_DOMAIN=meet.example.com
# MPESA_CONSUMER_KEY= / MPESA_CONSUMER_SECRET= / MPESA_SHORTCODE= / MPESA_PASSKEY=   (Module 5)
# FLUTTERWAVE_SECRET_KEY= / FLUTTERWAVE_WEBHOOK_HASH=                                (Module 5)
